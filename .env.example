# ════════════════════════════════════════════════════════════
#  KineVisión Frontend — Variables de entorno
#  En Vercel estas variables se configuran en el dashboard
#  (Settings → Environment Variables).
# ════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────
# Supabase → Settings → API → Project URL y anon public key
VITE_SUPABASE_URL=https://kedsvrottxqsnnnnenjy.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ── Backend ───────────────────────────────────────────────────
# URL pública del backend en Railway.
# En desarrollo NO definas esta variable → Vite usa el proxy a localhost:4000.
# En producción (Vercel) ponla en el dashboard:
#   VITE_API_URL = https://kinevision-backend.up.railway.app
VITE_API_URL=https://tu-backend.up.railway.app
